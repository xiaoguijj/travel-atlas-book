{
  "name": "travel-atlas-book",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Travel Atlas Book — 以交互式地球为入口的旅行创意手账网站",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "data:world": "node scripts/build-world-data.mjs",
    "data:hero": "node scripts/build-hero-assets.mjs",
    "data:journal": "node scripts/build-journal-assets.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.4",
    "jimp": "^0.22.12",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
