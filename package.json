{
  "name": "travel-atlas-book",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Travel Atlas Book — 以交互式地球为入口的旅行创意手账网站",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "data:world": "node scripts/build-world-data.mjs",
    "data:hero": "node scripts/build-hero-assets.mjs",
    "data:inner": "node scripts/build-inner-assets.mjs",
    "data:paper": "node scripts/build-paper-assets.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@tiptap/core": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "@tiptap/react": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "dexie": "4.4.7",
    "konva": "10.10.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-konva": "18.2.14",
    "react-router-dom": "6.28.0",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.4",
    "fake-indexeddb": "6.2.8",
    "jimp": "^0.22.12",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "3.2.4"
  }
}
